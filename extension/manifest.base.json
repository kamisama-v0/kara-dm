{
  "manifest_version": 3,
  "name": "Kara DM",
  "version": "0.1.3",
  "description": "Send downloads and videos from your browser to Kara Download Manager (multi-connection). Also works with Neat Download Manager.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Kara DM",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["downloads", "cookies", "contextMenus", "storage", "notifications", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["common.js", "content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
